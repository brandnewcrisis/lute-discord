--!strict
local Commands = require("@discord/commands")
local Const = require("@discord/const")
local h = require("./harness")

local ping = Commands.slash("ping", "Check I am alive"):toJSON()
h.equals("chat input type", ping.type, Const.CommandType.CHAT_INPUT)
h.equals("name", ping.name, "ping")

h.throws("uppercase names rejected", "lowercase", function()
	Commands.slash("Ping", "x")
end)
h.throws("spaces rejected", "lowercase", function()
	Commands.slash("my command", "x")
end)
h.throws("empty description rejected", "1 to 100", function()
	Commands.slash("ok", "")
end)

local opts = Commands.slash("ban", "Ban someone")
	:userOption("user", "Who", { required = true })
	:stringOption("reason", "Why")
	:toJSON()
h.equals("option types", h.some(opts.options)[1].type, Const.OptionType.USER)
h.equals("required flag", h.some(opts.options)[1].required, true)
h.equals("optional stays absent", h.some(opts.options)[2].required, nil)

-- Discord rejects the whole command if a required option follows an
-- optional one, so it is caught at build time.
h.throws("required must precede optional", "must come before", function()
	Commands.slash("x", "y"):stringOption("a", "a"):stringOption("b", "b", { required = true })
end)
h.throws("choices and autocomplete are exclusive", "both choices and autocomplete", function()
	Commands.slash("x", "y"):stringOption("a", "a", { autocomplete = true, choices = { { name = "n", value = "v" } } })
end)

local nested = Commands.slash("role", "Manage roles")
	:subcommand("add", "Give a role", function(sub)
		sub:userOption("user", "Who", { required = true })
		sub:roleOption("role", "Which", { required = true })
	end)
	:subcommand("remove", "Take a role", function(sub)
		sub:userOption("user", "Who", { required = true })
	end)
	:toJSON()
h.equals("subcommand type", h.some(nested.options)[1].type, Const.OptionType.SUB_COMMAND)
h.equals("subcommand options nest", #h.some(h.some(nested.options)[1].options), 2)
h.equals("two subcommands", #h.some(nested.options), 2)

local grouped = Commands.slash("config", "Configure")
	:group("roles", "Role settings", function(group)
		group:subcommand("add", "Add", function(sub)
			sub:roleOption("role", "Which", { required = true })
		end)
	end)
	:toJSON()
h.equals("group type", h.some(grouped.options)[1].type, Const.OptionType.SUB_COMMAND_GROUP)
h.equals("group holds subcommands", h.some(h.some(grouped.options)[1].options)[1].type, Const.OptionType.SUB_COMMAND)

h.throws("groups cannot nest", "cannot contain another group", function()
	Commands.slash("x", "y"):group("a", "a", function(group)
		group:group("b", "b", function() end)
	end)
end)

local gated = Commands.slash("purge", "Delete messages")
	:defaultPermissions("manageMessages")
	:guildOnly()
	:toJSON()
h.equals("default permissions as a decimal string", gated.default_member_permissions, "8192")
h.equals("guild only context", h.some(gated.contexts)[1], 0)

local menu = Commands.userCommand("Who is this"):toJSON()
h.equals("context menu type", menu.type, Const.CommandType.USER)
h.equals("context menus carry no description", menu.description, nil)

-- Errors must name the bot's line, not the library's: the message is
-- prefixed with the file that made the mistake.
h.throws("a bad option name blames the caller", "commands.test.luau", function()
	Commands.slash("x", "y"):stringOption("Bad Name", "d")
end)
h.throws("ordering errors through a shorthand blame the caller", "commands.test.luau", function()
	Commands.slash("x", "y"):stringOption("a", "a"):stringOption("b", "b", { required = true })
end)
h.throws("an unknown permission blames the caller", "commands.test.luau", function()
	Commands.slash("x", "y"):defaultPermissions("notAPermission")
end)
h.throws("a bad subcommand name blames the caller", "commands.test.luau", function()
	Commands.slash("x", "y"):subcommand("NO", "d")
end)

h.throws("min on a string points at minLength", "minLength", function()
	Commands.slash("x", "y"):stringOption("a", "a", { min = 2 })
end)
h.throws("channelTypes on a user option is refused", "channel options only", function()
	Commands.slash("x", "y"):userOption("a", "a", { channelTypes = { 0 } })
end)
h.throws("subcommands and plain options cannot share a level", "cannot mix", function()
	Commands.slash("x", "y"):stringOption("a", "a"):subcommand("b", "b")
end)
h.throws("duplicate option names are refused", "both named", function()
	Commands.slash("x", "y"):stringOption("a", "a"):integerOption("a", "b")
end)
h.check("non-ASCII names pass through to Discord's own check", pcall(function()
	Commands.slash("grüße", "Say hello")
end))
local localized = Commands.slash("x", "y")
	:numberOption("amount", "How much", { min = 0.5, nameLocalizations = { de = "menge" } })
	:toJSON()
local amount = h.some(localized.options)[1]
h.equals("numberOption is a NUMBER", amount.type, Const.OptionType.NUMBER)
h.equals("option name localizations are sent", h.some(amount.name_localizations).de, "menge")
local anywhere = Commands.slash("x", "y"):userInstallable():toJSON()
h.equals("user-installable commands allow private channels", #h.some(anywhere.contexts), 3)
h.equals("guildOnly(false) stays within guild-install contexts", #h.some(Commands.slash("x", "y"):guildOnly(false):toJSON().contexts), 2)

h.finish()
